---
/**
 * DarkMode - Inline script to handle dark mode initialization
 *
 * Checks localStorage for user preference and respects system color scheme.
 * Add to <head> for early theme loading.
 *
 * @example
 * ```astro
 * <DarkMode />
 * ```
 */
---

<script is:inline>
  const theme = localStorage.getItem("theme");

  if (
    theme === "dark" ||
    (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
  ) {
    document.documentElement.classList.add("dark");
  }
</script>
