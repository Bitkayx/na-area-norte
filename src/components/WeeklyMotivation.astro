---
import { Icon } from "astro-icon/components";
import { dal } from "../lib/dal";

/**
 * WeeklyMotivation - Banner component showing current week's radio broadcast
 *
 * Displays the next dated radio participation from PocketBase.
 * Includes close button to dismiss the banner.
 *
 * @example
 * ```astro
 * <WeeklyMotivation />
 * ```
 */

const currentData = await dal.radio.getNext();
const owner = currentData?.ownerIsAreaNorte
  ? "Área Norte"
  : currentData?.district?.name;
const formattedDate = currentData?.broadcastDate?.toLocaleDateString("es-MX", {
  timeZone: "UTC",
  day: "numeric",
  month: "long",
});
---

<div id="weekly-motivation" class="bg-primary text-white py-3 px-4 mb-4">
  <div
    class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3"
  >
    <div class="flex items-center gap-3 flex-col md:flex-row">
      <Icon name="material-symbols:radio" class="text-xl" />
      <span class="font-bold">
        Radiodifusora{formattedDate ? ` - ${formattedDate}:` : ":"}
      </span>
      <span>
        {
          owner
            ? `${owner}${currentData?.time ? ` a las ${currentData.time}` : ""}`
            : "Próximo rol por publicar"
        }
      </span>
    </div>
    <div class="flex items-center gap-3">
      {
        currentData?.link && (
          <a
            href={currentData.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 bg-white text-primary px-4 py-1.5 rounded-lg text-sm font-bold hover:bg-white/90 transition-colors"
          >
            <Icon name="material-symbols:play-arrow" class="text-lg" />
            Escuchar
          </a>
        )
      }
      <button
        id="close-motivation"
        class="p-1 hover:bg-white/20 rounded transition-colors"
        aria-label="Cerrar"
      >
        <Icon name="material-symbols:close" class="text-xl" />
      </button>
    </div>
  </div>
</div>

<script defer is:inline>
  document.addEventListener("click", (e) => {
    const closeButton =
      e.target.closest && e.target.closest("#close-motivation");
    if (!closeButton) return;

    const banner = document.getElementById("weekly-motivation");
    if (banner) banner.style.display = "none";
  });
</script>
