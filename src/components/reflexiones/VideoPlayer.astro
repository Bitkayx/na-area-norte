---
interface Props {
  videoUrl: string;
  title: string;
}

const { videoUrl, title } = Astro.props;
---

<div class="relative w-full aspect-[9/16] sm:aspect-video rounded-xl sm:rounded-2xl overflow-hidden bg-slate-900 shadow-xl sm:shadow-2xl">
  <iframe
    src={videoUrl}
    title={title}
    class="absolute inset-0 w-full h-full"
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
  />
</div>