---
import { getCurrentDay, getCurrentMonth, getMonthName } from "@utils/reflexiones";

interface Props {
  totalDays: number;
  visitedCount: number;
}

const { totalDays, visitedCount } = Astro.props;
const currentDay = getCurrentDay();
const currentMonth = getCurrentMonth();
const progress = totalDays > 0 ? Math.round((visitedCount / totalDays) * 100) : 0;
---

<div id="progress-header" class="bg-gradient-to-r from-primary/10 to-primary/5 dark:from-primary/20 dark:to-primary/10 rounded-2xl p-6 mb-8">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Reflexiones de {getMonthName(currentMonth)}
      </h2>
      <p id="progress-text" class="text-slate-600 dark:text-slate-400">
        {visitedCount} de {totalDays} reflexiones vistas
      </p>
    </div>
    <div class="text-right">
      <span id="progress-percent" class="text-3xl font-bold text-primary">{progress}%</span>
      <p class="text-xs text-slate-500 dark:text-slate-400">completado</p>
    </div>
  </div>
  <div class="h-3 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
    <div
      id="progress-bar"
      class="h-full bg-gradient-to-r from-primary to-green-500 rounded-full transition-all duration-500"
      style={`width: ${progress}%`}
    />
  </div>
  <p id="progress-message" class="mt-3 text-sm text-slate-600 dark:text-slate-400">
    {currentDay > visitedCount 
      ? `Tienes ${currentDay - visitedCount} reflexiones pendientes del mes.`
      : "¡Felicidades! Has visto todas las reflexiones de este mes."}
  </p>
</div>