---
import Layout from "../../layouts/Layout.astro";
import InventoryTable from "../../components/InventoryTable.tsx";
import inventoryFallback from "../../data/inventory.json";
import { dal } from "../../lib/dal/index.ts";
import { formatDate } from "../../utils/dateUtils.ts";

const title = "Literatura";

type InventoryTableItem = {
  code: string | null;
  description: string;
  price: number;
  category: string;
};

const [categories, literature, siteSettings] = await Promise.all([
  dal.categories.getAll(),
  dal.literature.getAll(),
  dal.siteSettings.get(),
]);
const literatureSettings = siteSettings?.literature;
const inventorySchedule = literatureSettings?.nextInventory;
const salesSchedule = literatureSettings?.salesSchedule;
const todayInMexico = new Intl.DateTimeFormat("en-CA", {
  timeZone: "America/Mexico_City",
}).format(new Date());
const showInventorySchedule = !!inventorySchedule && inventorySchedule.date >= todayInMexico;
const inventoryParticipants = inventorySchedule
  ? [
      ...inventorySchedule.districts.map((district) => `Distrito ${district}`),
      ...(inventorySchedule.areaNorte ? ["Área Norte"] : []),
    ].join(", ")
  : "";
const weekdayNames = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"];
const salesDays = salesSchedule?.days.map((day) => weekdayNames[day - 1]).join(", ") ?? "";
const remoteItems: InventoryTableItem[] = categories.flatMap((category) =>
  literature
    .filter((item) => item.categoryId === category.id)
    .map((item) => ({
      code: item.code,
      description: item.title,
      price: item.price,
      category: category.name,
    })),
);
const literatures: InventoryTableItem[] =
  literature.length > 0 && remoteItems.length === literature.length
    ? remoteItems
    : inventoryFallback.map((item) => ({
        code: item.code,
        description: item.description,
        price: item.price,
        category: item.category,
      }));
---

<Layout title={title}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="mb-8">
      <a
        href="/servicios/"
        class="text-primary hover:text-primary/80 text-sm font-bold mb-4 inline-flex items-center gap-1"
      >
        ← Volver a Servicios
      </a>
      <h1
        class="text-4xl md:text-5xl font-extrabold text-slate-800 dark:text-white mb-4"
      >
        {title}
      </h1>
    </header>

    <div class="text-slate-600 dark:text-slate-300 leading-relaxed">
      <p class="mb-4">
        Motivar el conocimiento, comprensión, utilización y difusión de nuestra
        literatura mediante mecanismos de capacitación para estimular la
        adquisición, estudio y compartimiento de la misma.
      </p>

      <h2
        class="text-xl font-semibold text-slate-800 dark:text-slate-100 mb-3 mt-6"
      >
        Funciones
      </h2>
      <ul class="list-disc list-inside mb-4 space-y-1">
        <li>
          Organizar reuniones en el Comité Estatal o de Área para el estudio de
          la literatura.
        </li>
        <li>
          Crear dinámicas de estudio para compartirlas con los Representantes de
          Literatura de los Distritos o de los Grupos.
        </li>
        <li>Adquirir la literatura en la Oficina de Servicios Generales.</li>
        <li>Promover la difusión y adquisición de la literatura.</li>
      </ul>
    </div>

    {
      showInventorySchedule && inventorySchedule && (
        <section class="mt-10" aria-labelledby="inventory-schedule-title">
          <hr />
          <h2
            id="inventory-schedule-title"
            class="text-xl font-semibold text-slate-800 dark:text-slate-100 mb-3 mt-10"
          >
            Próximo Inventario Mensual
          </h2>
          <p>
            {formatDate(inventorySchedule.date)}
            {inventorySchedule.time ? ` | ${inventorySchedule.time}` : ""}
          </p>
          {inventoryParticipants && <p>Participan: {inventoryParticipants}</p>}
        </section>
      )
    }

    {
      salesSchedule && (
        <section class="mt-10" aria-labelledby="literature-sales-title">
          <h2
            id="literature-sales-title"
            class="text-xl font-semibold text-slate-800 dark:text-slate-100 mb-3"
          >
            Días de venta de Literatura
          </h2>
          <p>{salesDays} | De {salesSchedule.startTime} a {salesSchedule.endTime}</p>
        </section>
      )
    }
  </div>
  <h2
    class="text-xl font-semibold text-slate-800 dark:text-slate-100 mb-3 mt-6 text-center"
  >
    Lista de Literatura
  </h2>
  <InventoryTable items={literatures} client:visible />
</Layout>
