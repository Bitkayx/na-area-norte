---
import Layout from "../../layouts/Layout.astro";
import InventoryTable from "../../components/InventoryTable.tsx";
import literatures from "../../data/inventory.json";

const title = "Literatura";
---

<Layout title={title}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="mb-8">
      <a
        href="/servicios/"
        class="text-primary hover:text-primary/80 text-sm font-bold mb-4 inline-flex items-center gap-1"
      >
        ← Volver a Servicios
      </a>
      <h1
        class="text-4xl md:text-5xl font-extrabold text-slate-800 dark:text-white mb-4"
      >
        {title}
      </h1>
      <p class="text-lg text-slate-500 dark:text-slate-400">
        Comité Auxiliar - Área Norte
      </p>
    </header>

    <div class="text-slate-600 dark:text-slate-300 leading-relaxed">
      <p class="mb-4">
        El Comité de Literatura se encarga de la distribución y venta de
        material bibliográfico de Neuróticos Anónimos.
      </p>

      <h2
        class="text-xl font-semibold text-slate-800 dark:text-slate-100 mb-3 mt-6"
      >
        Funciones principales
      </h2>
      <ul class="list-disc list-inside mb-4 space-y-1">
        <li>Administrar el inventario de libros y folletos</li>
        <li>Atender pedidos de grupos y áreas</li>
        <li>Promover la lectura de material NL</li>
      </ul>

      <h2
        class="text-xl font-semibold text-slate-800 dark:text-slate-100 mb-3 mt-6"
      >
        Inventario del mes de Febrero
      </h2>
    </div>

    <InventoryTable items={literatures} client:visible />
  </div>
</Layout>
