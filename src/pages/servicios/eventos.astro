---
import Layout from "../../layouts/Layout.astro";
import BlogPost from "../../components/BlogPost.astro";
import { dal } from "../../lib/dal/index.ts";
import { getNewsItems } from "../../lib/news.ts";
import { formatDate } from "../../utils/dateUtils.ts";

const title = "Eventos";
const news = await getNewsItems();
const latestEventPost = news.find((post) => {
  const tags = post.tags.map((tag) => tag.trim().toLocaleLowerCase());
  return tags.includes("eventos") && !tags.includes("invitaciones") && !tags.includes("calendario");
});
const nextEvent = await dal.events.getNext();
const nextEventDate = nextEvent?.startDate
  ? formatDate(nextEvent.startDate.toISOString())
  : null;
const nextEventLocation = nextEvent?.location
  ? [nextEvent.location.linea1, nextEvent.location.colonia, nextEvent.location.ciudad, nextEvent.location.estado]
      .filter(Boolean)
      .join(", ")
  : null;
---

<Layout title={title}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="mb-8">
      <a
        href="/servicios/"
        class="text-primary hover:text-primary/80 text-sm font-bold mb-4 inline-flex items-center gap-1"
      >
        ← Volver a Servicios
      </a>
      <h1
        class="text-4xl md:text-5xl font-extrabold text-slate-800 dark:text-white mb-4"
      >
        {title}
      </h1>
    </header>

    <div class="prose prose-slate dark:prose-invert max-w-none">
      <p>
        Planificar y cooperar en la realización de los eventos del Comité
        Estatal o de Área.
      </p>

      <h2>Funciones</h2>
      <ul>
        <li>
          Apoyar la organización de los eventos del Comité Estatal o de Área
          como: congresos, seminarios, encuentros de literatura, o cualquier
          otro evento a nivel Comité Estatal o de Área.
        </li>
        <li>
          Cuando haya eventos a nivel regional, organizará el traslado,
          contratará el transporte e informará los costos, tanto de transporte
          como del evento.
        </li>
        <li>
          Promoverá los eventos de otras Regiones, Estados o Áreas y colocará
          los carteles alusivos en el Comité Estatal o de Área.
        </li>
        <li>Apoyará al Comité Estatal o de Área en lo que sea necesario.</li>
      </ul>

    </div>

    {
      nextEvent && (
        <section class="mt-10">
          <h2 class="text-2xl font-bold mb-4">Próximo evento</h2>
          <article class="rounded-xl border border-slate-200 dark:border-slate-700 p-6">
            <h3 class="text-xl font-semibold">{nextEvent.title}</h3>
            {nextEventDate && <p class="mt-2">{nextEventDate}</p>}
            {nextEventLocation && <p class="mt-1">{nextEventLocation}</p>}
            {nextEvent.postRef?.slug && (
              <a class="mt-4 inline-block text-primary font-bold" href={`/noticias/${nextEvent.postRef.slug}`}>
                Ver publicación del evento
              </a>
            )}
          </article>
        </section>
      )
    }

    {
      latestEventPost && (
        <section class="mt-10">
          <h2 class="text-2xl font-bold mb-4">Última publicación de eventos</h2>
          <BlogPost
            url={`/noticias/${latestEventPost.slug}`}
            title={latestEventPost.title}
            description={latestEventPost.description}
            pubDate={latestEventPost.pubDate}
            image={latestEventPost.image}
            tags={latestEventPost.tags}
          />
        </section>
      )
    }
  </div>
</Layout>
