---
import Layout from "../../layouts/Layout.astro";
import BannerPromocional from "@components/BannerPromocional.astro";
import MotivacionEvento from "@components/MotivacionEvento.astro";
import encuentroServidores from "../../assets/blog/compartimientos/eventos/encuentro-servidores-2026.jpeg";
import congresoRegional from "../../assets/blog/compartimientos/eventos/CONGRESO_CHALCO.jpg";
import congresoRegionalVideo from "../../assets/blog/compartimientos/abril/congreso_regional.mp4";

const title = "Eventos";
---

<Layout title={title}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="mb-8">
      <a
        href="/servicios/"
        class="text-primary hover:text-primary/80 text-sm font-bold mb-4 inline-flex items-center gap-1"
      >
        ← Volver a Servicios
      </a>
      <h1
        class="text-4xl md:text-5xl font-extrabold text-slate-800 dark:text-white mb-4"
      >
        {title}
      </h1>
    </header>

    <div class="prose prose-slate dark:prose-invert max-w-none">
      <p>
        Planificar y cooperar en la realización de los eventos del Comité
        Estatal o de Área.
      </p>

      <h2>Funciones</h2>
      <ul>
        <li>
          Apoyar la organización de los eventos del Comité Estatal o de Área
          como: congresos, seminarios, encuentros de literatura, o cualquier
          otro evento a nivel Comité Estatal o de Área.
        </li>
        <li>
          Cuando haya eventos a nivel regional, organizará el traslado,
          contratará el transporte e informará los costos, tanto de transporte
          como del evento.
        </li>
        <li>
          Promoverá los eventos de otras Regiones, Estados o Áreas y colocará
          los carteles alusivos en el Comité Estatal o de Área.
        </li>
        <li>Apoyará al Comité Estatal o de Área en lo que sea necesario.</li>
      </ul>

      <hr />

      <MotivacionEvento
        title="Proximo Evento"
        subtitle="Encuentro de Servidores"
        image={encuentroServidores}
        description="Los motivamos a hacer la Unidad compañeros, pueden apartar su lugar en el autobus. Para mayor informacion pregunta con tu Comité de eventos en el Distrito o bien con tu RD."
      />
    </div>

    <BannerPromocional
      title="Encuentro de Servidores 2026"
      description="Encuentra el programa del evento aqui"
      url="/noticias/encuentro-de-servidores"
      ctaText="Ver programa"
    />

    <div class="prose prose-slate dark:prose-invert max-w-none mt-8">
      <MotivacionEvento
        title="Proximamente..."
        description="Congreso V Region 2026"
        image={congresoRegional}
      />

      <video controls>
        <source src={congresoRegionalVideo} type="video/mp4" />
      </video>
    </div>
  </div>
</Layout>
