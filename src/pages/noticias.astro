---
import Layout from "../layouts/Layout.astro";
import BlogPost from "../components/BlogPost.astro";
import { getNewsItems } from "../lib/news.ts";

const allPosts = await getNewsItems();
---

<Layout title="Noticias">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="mb-10 space-y-3 text-center md:text-left">
      <h1
        class="text-6xl md:text-7xl font-extrabold text-slate-800 dark:text-white leading-[1.05] tracking-tight"
      >
        Noticias
      </h1>
      <p class="text-base text-slate-500">
        Enterate de todas las noticias que tenemos para ti, haz clic en algun
        post para ver de que trata.
      </p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        allPosts.map((post) => (
          <BlogPost
            url={`/noticias/${post.slug}`}
            title={post.title}
            description={post.description}
            pubDate={post.pubDate}
            author={post.author ?? undefined}
            image={post.image}
            tags={post.tags}
          />
        ))
      }
      {allPosts.length === 0 && (
        <p class="md:col-span-2 py-8 text-center text-slate-500">
          No hay noticias publicadas en este momento.
        </p>
      )}
    </section>
  </div>
</Layout>
