---
import MarkdownPostLayout from "@layouts/MarkdownPostLayout.astro";
import { dal } from "../../lib/dal/index.ts";
import { marked } from "marked";

export async function getStaticPaths() {
  const published = await dal.posts.getPublished();
  return published.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;

const pbPost = slug ? await dal.posts.getBySlug(slug) : undefined;

if (!pbPost) {
  throw new Error(`Published PocketBase post not found: ${slug}`);
}

const body = pbPost.body ?? "";
if (!body.trim() && pbPost.bodyImageUrls.length === 0) {
  throw new Error(`Published PocketBase post has no body: ${slug}`);
}

const fm = {
  title: pbPost.title,
  pubDate: pbPost.pubDate ?? undefined,
  description: pbPost.description,
  author: pbPost.author ?? "Área Norte",
  image: pbPost.coverUrl
    ? { url: pbPost.coverUrl, alt: pbPost.title }
    : undefined,
  tags:
    pbPost.tags.length > 0 ? pbPost.tags.map((t) => t.slug) : pbPost.tagIds,
};
const htmlBody = marked
  .parse(body)
  .replace(/src="\.\.\/assets\//g, 'src="/assets/');
---

<MarkdownPostLayout frontmatter={fm}>
  {body.trim() && <div set:html={htmlBody} />}
  {pbPost.bodyImageUrls.length > 0 && (
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {pbPost.bodyImageUrls.map((url, index) => (
        <figure>
          <img
            src={url}
            alt={`Imagen ${index + 1} de ${pbPost.title}`}
            loading="lazy"
            decoding="async"
            class="h-auto w-full rounded-lg"
          />
        </figure>
      ))}
    </div>
  )}
</MarkdownPostLayout>
