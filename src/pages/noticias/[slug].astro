---
import { getCollection, render } from "astro:content";
import MarkdownPostLayout from "@layouts/MarkdownPostLayout.astro";
import { dal } from "../../lib/dal/index.ts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post: any) => ({
    params: { slug: post.id },
    props: {},
  }));
}

const { slug } = Astro.params;

let fm: any = null;
let useHtml = false;
let htmlBody = "";
let ContentComp: any = null;

if (slug === "fraterna_80" || slug === "asamblea-mexicana" || slug === "congreso-regional-2026" || slug === "mave-2026" || slug === "encuentro-de-servidores" || slug === "invitaciones-marzo-2026") {
  const pbPost = await dal.posts.getBySlug(slug);
  if (pbPost) {
    fm = {
      title: pbPost.title,
      pubDate: pbPost.pubDate ?? undefined,
      description: pbPost.description,
      author: pbPost.author ?? "Área Norte",
      image: pbPost.coverUrl
        ? { url: pbPost.coverUrl, alt: pbPost.title }
        : undefined,
      tags: pbPost.tags.length > 0 ? pbPost.tags.map((t) => t.slug) : pbPost.tagIds,
    };
    const body = pbPost.body ?? "";
    if (body.trim()) {
      useHtml = true;
      htmlBody = body;
    } else {
      fm = null; // fall back if empty
    }
  }
}

if (!fm) {
  const posts = await getCollection("blog");
  const post = posts.find((p: any) => p.id === slug);
  if (!post) throw new Error(`Post not found: ${slug}`);
  fm = post.data;
  const rendered = await render(post);
  ContentComp = rendered.Content;
}
---
<MarkdownPostLayout frontmatter={fm}>
  {useHtml ? <div set:html={htmlBody} /> : <ContentComp />}
</MarkdownPostLayout>
