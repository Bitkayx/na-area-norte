---
import { getCollection, render } from "astro:content";
import MarkdownPostLayout from "@layouts/MarkdownPostLayout.astro";
import { dal } from "../../lib/dal/index.ts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post: any) => ({
    params: { slug: post.id },
    props: {},
  }));
}

const { slug } = Astro.params;

let postData: any = null;
let isDal = false;

if (slug === "fraterna_80") {
  const pbPost = await dal.posts.getBySlug("fraterna_80");
  if (pbPost) {
    const frontmatter = {
      title: pbPost.title,
      pubDate: pbPost.pubDate ?? undefined,
      description: pbPost.description,
      author: pbPost.author ?? "Área Norte",
      image: pbPost.coverUrl
        ? { url: pbPost.coverUrl, alt: pbPost.title }
        : undefined,
      tags: pbPost.tags.length > 0 ? pbPost.tags.map((t) => t.slug) : pbPost.tagIds,
    };
    const body = pbPost.body ?? "";
    const bodyIsHtml = body.includes("<") && body.includes(">");
    postData = { frontmatter, body, bodyIsHtml };
    isDal = true;
  }
}

if (!isDal) {
  const posts = await getCollection("blog");
  const post = posts.find((p: any) => p.id === slug);
  if (!post) throw new Error(`Post not found: ${slug}`);
  const { Content, headings, remarkPluginFrontmatter } = await render(post);
  postData = { post, Content };
  isDal = false;
}
---
{isDal ? (
  <MarkdownPostLayout frontmatter={postData.frontmatter}>
    {postData.bodyIsHtml ? (
      <div set:html={postData.body} />
    ) : (
      (() => {
        const C = postData.Content;
        return <C />;
      })()
    )}
  </MarkdownPostLayout>
) : (
  <MarkdownPostLayout frontmatter={postData.post.data}>
    <postData.Content />
  </MarkdownPostLayout>
)}
